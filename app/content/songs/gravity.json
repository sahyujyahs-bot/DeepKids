  {
   "name": "Verse",
   "lines": [
    "Space & Time,",
    "A blanket fine-",
    "Holds you & I,",
    "The mountains high,",
    "The planets known,",
    "And billions more in the sky;",
    "Curves & stretches where",
    "Mass is high"
   ]
  },
  {
   "name": "Verse 2",
   "lines": [
    "What can we do, you & I,",
    "Against a curve so deep,",
    "But spiral in towards",
    "Its centre, far from sight",
    "At the heart of the planet,",
    "That outweighs I;",
    "Spiral in & Spiral in,",
    "Towards the eye,",
    "Where comes to close,",
    "The Gravity that had me tied."
   ]
  },
  {
   "name": "Chorus",
   "lines": [
    "Gravity! Oh Gravity!",
    "Are you good or bad?",
    "You bring the Universe together,",
    "Keep us alive,",
    "But you don't let me fly!",
    "What would we do without you?",
    "Live or die?",
    "Or is it a moot?",
    "Since you never leave our side!"
   ]
  },
  {
   "name": "Outro",
   "lines": [
    "Gravity! Oh Gravity!",
    "Curved in Space & Time,",
    "A blanket fine,",
    "Gravity..."
   ]
  }
 ],
